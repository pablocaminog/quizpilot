{
  "name": "quizpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:ui": "astro dev",
    "dev:worker": "vite dev --config vite.worker.config.js --port 8787",
    "build:ui": "astro build",
    "build:worker": "vite build --config vite.worker.config.js && node scripts/patch-worker-config.mjs",
    "build": "npm run build:ui && npm run build:worker",
    "test": "node --test tests/unit/",
    "test:integration": "node scripts/integration.mjs",
    "package": "npm run build && wrangler deploy --config dist/quizpilot/wrangler.json --dry-run",
    "check": "npm run build && npm test && npm run test:integration && wrangler deploy --config dist/quizpilot/wrangler.json --dry-run"
  },
  "dependencies": {
    "@flue/runtime": "2.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.2",
    "hono": "4.13.16",
    "lucide-react": "1.67.0",
    "next-themes": "0.4.6",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "valibot": "1.5.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@astrojs/react": "7.1.2",
    "@cloudflare/vite-plugin": "1.67.0",
    "@flue/vite": "2.3.0",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.5",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "vite": "8.3.5",
    "wrangler": "4.157.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-schema": "1.4.0"
  }
}
